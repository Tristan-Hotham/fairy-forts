 "quotes": [
  {
   "id": "TN00680",
   "text": "The site was levelled c. 50 years ago but because of superstition the area where the 'fort' stood has been left fallow.",
   "county": "Tipperary North",
   "townland": "Monsea",
   "cls": "Ringfort - rath",
   "status": "gone"
  },
  {
   "id": "OF01136",
   "text": "The local landowner will not touch the overgrowth on this ridge because he believes that it is a fairy fort.",
   "county": "Offaly",
   "townland": "Rathrobin",
   "cls": "Enclosure",
   "status": "visible"
  },
  {
   "id": "CO05478",
   "text": "No visible surface trace. According to local information, an old man living in the area pointed to a clump of furze here and said that bad luck would come to any one who ploughed it.",
   "county": "Cork",
   "townland": "Kilbarry (Condons And Clongibbon By.)",
   "cls": "Ringfort - rath",
   "status": "gone"
  },
  {
   "id": "GA02126",
   "text": "No visible surface trace of either survives. According to local tradition, it is unlucky to till the field.",
   "county": "Galway",
   "townland": "Tirur",
   "cls": "Ringfort - unclassified",
   "status": "gone"
  },
  {
   "id": "MA05990",
   "text": "According to local tradition, this is the site of ‘fairy trees’ (hawthorn) and for this reason was never disturbed.",
   "county": "Mayo",
   "townland": "Bunnadober (Costello By.)",
   "cls": "Enclosure",
   "status": "gone"
  },
  {
   "id": "OF05141",
   "text": "According to local information this was the site of a 'fairy fort' which was bulldozed in the 1960s.",
   "county": "Offaly",
   "townland": "Gorteen (Kilcoursey By.)",
   "cls": "Enclosure",
   "status": "gone"
  },
  {
   "id": "WI03453",
   "text": "It is said that a man went to plough it and as soon as he put his hands on the plough, The horse & Plough were took out of his hands and they never came back",
   "county": "Wicklow",
   "townland": "Calary Upper",
   "cls": "Ringfort - rath",
   "status": "visible"
  },
  {
   "id": "KK00340",
   "text": "the place was dug up several years ago by money dreamers and the stones carried away by some wicked man who had not the fear of Oisinn or the fairies before his eyes, but he died since, tho' not very old!",
   "county": "Kilkenny",
   "townland": "Rathosheen",
   "cls": "Ringfort - rath",
   "status": "damaged"
  },
